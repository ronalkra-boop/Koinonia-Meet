# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# TURN (Recomendado para conexión instantánea en redes 4G/5G con NAT simétrico)
# ---------------------------------------------------------------------------
# Opción A (recomendada): Metered. Crea una cuenta gratis en https://dashboard.metered.ca/signup
#   METERED_APP_NAME = el nombre de tu app (aparece en el Dashboard, ej: tuapp.metered.live)
#   METERED_API_KEY  = la API key del TURN (Dashboard > TURN Server)
# El servidor obtiene y renueva automáticamente las credenciales TURN.
METERED_APP_NAME=""
METERED_API_KEY=""

# Opción B: cualquier otro TURN (coturn, Cloudflare, Twilio, etc.)
# TURN_URL="turn:mi-servidor:3478,turns:mi-servidor:443?transport=tcp"
# TURN_USERNAME=""
# TURN_CREDENTIAL=""

